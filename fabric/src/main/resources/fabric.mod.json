{
    "schemaVersion": 1,
    "id": "visibleores",
    "version": "${version}",
    "name": "Visible Ores",
    "description": "A client-side mod that swaps ore textures per ore, dimension and height, with Standard, Fancy and Custom texture sets",
    "authors": [
        "Winord"
    ],
    "contact": {
        "issues": "https://github.com/Winord/VisibleOres/issues"
    },
    "license": "GPLv3",
    "icon": "assets/visibleores/icon.png",
    "environment": "client",
    "entrypoints": {
        "client":  [ "winord.visibleores.fabric.VisibleOresFabricClient" ],
        "modmenu": [ "winord.visibleores.fabric.ModMenuIntegration" ]
    },
    "depends": {
        "fabricloader": ">=0.19.5",
        "fabric-api": "*",
        "architectury": ">=22",
        "minecraft": ">=26.3 <26.4",
        "java": ">=25"
    },
    "suggests": {
        "cloth-config": "*",
        "modmenu": "*"
    }
}
